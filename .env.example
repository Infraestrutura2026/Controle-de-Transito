# ============================================================
# CONTROLE DE SAÍDAS — variáveis de ambiente
#
# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA envie o .env para o GitHub (ele já está no .gitignore).
# ============================================================

# Banco de dados PostgreSQL.
# Local:      postgresql://postgres:senha@localhost:5432/app_db
# Supabase:   use a string "Transaction pooler" (porta 6543) do painel:
#             Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:senha@localhost:5432/app_db

# Defina como "true" quando o banco exigir SSL (ex.: Supabase).
# Obs.: URLs do Supabase são detectadas automaticamente.
DATABASE_SSL=false

# Domínio do preview de desenvolvimento (opcional, só para dev remoto).
NEXT_ALLOWED_DEV_ORIGIN=
